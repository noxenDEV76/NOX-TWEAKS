<Project Sdk="Microsoft.NET.Sdk">

  <!-- Presentation logic with no WPF types, so it builds and is unit-tested on any OS. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <RootNamespace>NoxTweak.UI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NoxTweak.Core\NoxTweak.Core.csproj" />
  </ItemGroup>

</Project>
