<Window x:Class="NoxTweak.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:NoxTweak.UI;assembly=NoxTweak.UI"
        xmlns:views="clr-namespace:NoxTweak.App.Views"
        xmlns:c="clr-namespace:NoxTweak.App.Controls"
        Title="NOX TWEAK" Width="1280" Height="800" MinWidth="1040" MinHeight="660"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterScreen"
        Icon="Assets/nox.ico" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        StateChanged="OnStateChanged">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}"><views:HomeView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:GameModeViewModel}"><views:GameModeView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:GamesViewModel}"><views:GamesView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:OptimizeViewModel}"><views:OptimizeView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HardwareViewModel}"><views:HardwareView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:NetworkViewModel}"><views:NetworkView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BackupsViewModel}"><views:BackupsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogsViewModel}"><views:LogsView/></DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{StaticResource BgBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= Sidebar ================= -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="14,0,14,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="10,18,0,14">
                        <TextBlock Text="NOX" FontSize="36" FontWeight="Black" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="T W E A K" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="3,-7,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel>
                            <c:SwitchButton Style="{StaticResource GameNavStyle}" Content="{Binding GameModeNav.Name}" Glyph="{Binding GameModeNav.Glyph}"
                                            IsOn="{Binding GameModeNav.IsOn}" Command="{Binding GameModeNav.Command}"
                                            AutomationProperties.Name="NOX Game Mode"/>

                            <TextBlock Text="General" Style="{StaticResource Muted}" FontSize="12" Margin="12,18,0,6"/>
                            <ItemsControl ItemsSource="{Binding GeneralNav}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <c:SwitchButton Style="{StaticResource NavStyle}" Content="{Binding Name}" Glyph="{Binding Glyph}"
                                                        IsOn="{Binding IsOn}" Command="{Binding Command}" AutomationProperties.Name="{Binding Name}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Main" Style="{StaticResource Muted}" FontSize="12" Margin="12,18,0,6"/>
                            <ItemsControl ItemsSource="{Binding MainNav}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <c:SwitchButton Style="{StaticResource NavStyle}" Content="{Binding Name}" Glyph="{Binding Glyph}"
                                                        IsOn="{Binding IsOn}" Command="{Binding Command}" AutomationProperties.Name="{Binding Name}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- User / privilege chip -->
                    <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="10">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource AccentGradient}">
                                    <TextBlock Text="{Binding UserInitial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding UserName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding UserRole}" Style="{StaticResource Muted}" FontSize="11.5"/>
                                </StackPanel>
                            </Grid>
                            <Button Style="{StaticResource GhostButton}" Margin="0,10,0,0" Padding="8,6" FontSize="12"
                                    Content="Restart as administrator" Command="{Binding ElevateCommand}"
                                    ToolTip="Only needed for a few machine-wide settings. NOX TWEAK runs as a normal user otherwise."
                                    AutomationProperties.Name="Restart as administrator"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ================= Workspace ================= -->
            <Border Grid.Column="1" Background="{StaticResource WorkspaceBrush}">
                <ContentControl Content="{Binding Current}" IsTabStop="False"/>
            </Border>

            <!-- Window buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,6,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource WindowButton}" Content="&#xE921;" Click="OnMinimize" AutomationProperties.Name="Minimize"/>
                <Button x:Name="MaxButton" Style="{StaticResource WindowButton}" Content="&#xE922;" Click="OnMaximize" AutomationProperties.Name="Maximize"/>
                <Button Style="{StaticResource WindowButton}" Content="&#xE8BB;" Click="OnClose" AutomationProperties.Name="Close"/>
            </StackPanel>

            <!-- Toast -->
            <Border Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,26" MaxWidth="720"
                    Style="{StaticResource CardBorder}" Padding="16,10" Background="#1B1D2B"
                    Visibility="{Binding HasToast, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding ToastText}" TextWrapping="Wrap" MaxWidth="640"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
