<UserControl x:Class="NoxTweak.App.Views.BackupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource PageStyle}">
    <Grid Margin="32,40,32,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,10,0,0">
                <Button Style="{StaticResource GhostButton}" Content="Verify all" Command="{Binding VerifyCommand}" Margin="0,0,10,0"/>
                <Button Style="{StaticResource GhostButton}" Content="Open folder" Command="{Binding OpenFolderCommand}" Margin="0,0,10,0"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Create restore point" Command="{Binding RestorePointCommand}"/>
            </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1" Margin="0,20,-12,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,24">
                <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{Binding Explanation}" Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12.5"/>
                        <TextBlock Text="{Binding RestorePointInfo}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="No backups yet. A backup is created automatically the first time you change a setting." Style="{StaticResource Muted}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Padding="16,12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource Muted}" FontSize="12.5" Margin="0,4,0,0">
                                            <Run Text="{Binding Date, Mode=OneWay}"/> · <Run Text="{Binding Status, Mode=OneWay}"/> · <Run Text="{Binding Integrity, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Location}" Style="{StaticResource Muted}" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Restore" Command="{Binding RestoreCommand}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
