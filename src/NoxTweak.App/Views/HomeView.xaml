<UserControl x:Class="NoxTweak.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NoxTweak.App.Controls"
             Style="{StaticResource PageStyle}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,40,32,32">

            <!-- Header -->
            <TextBlock Text="{Binding Welcome}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,18"/>

            <!-- Restart banner (never restarts by itself) -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16" Background="#1E1A12" BorderBrush="{StaticResource WarnBrush}"
                    Visibility="{Binding HasPendingRestart, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource WarnBrush}" Margin="0,0,12,0" FontSize="20"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Some changes require a restart to take effect." FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding PendingRestartText}" Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12.5" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Content="Remind me later" Command="{Binding DismissRestartCommand}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Restart now" Command="{Binding RestartCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Three quick cards -->
            <UniformGrid Columns="3">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,12,0" MinHeight="116">
                    <Grid>
                        <Button Style="{StaticResource GhostButton}" Content="Open" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="12,4" FontSize="12"
                                Command="{Binding OpenBackupsCommand}" AutomationProperties.Name="Open backups"/>
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE777;" FontSize="22" Foreground="{StaticResource VioletBrush}" HorizontalAlignment="Left"/>
                            <TextBlock Text="Backups" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding BackupsText}" Style="{StaticResource Muted}" FontSize="12.5"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,12,0" MinHeight="116">
                    <Grid>
                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding ScanButtonText}" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="14,5" FontSize="12"
                                Command="{Binding ScanCommand}" AutomationProperties.Name="Scan my PC"/>
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE773;" FontSize="22" Foreground="{StaticResource VioletBrush}" HorizontalAlignment="Left"/>
                            <TextBlock Text="Scan my PC" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding ScanStatus}" Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardBorder}" MinHeight="116">
                    <Grid>
                        <Button Style="{StaticResource GhostButton}" Content="Optimize" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="12,4" FontSize="12"
                                Command="{Binding OptimizeCommand}" AutomationProperties.Name="Optimize my PC"/>
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="22" Foreground="{StaticResource VioletBrush}" HorizontalAlignment="Left"/>
                            <TextBlock Text="Optimize my PC" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            <TextBlock Text="Low-risk changes only. You see the list first." Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- Chart + Game Mode -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="310"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,14,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding ChartTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding CurrentValue}" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <c:SwitchButton Style="{StaticResource ChipStyle}" Content="CPU" IsOn="{Binding IsCpu}" Command="{Binding SelectMetricCommand}" CommandParameter="CPU"/>
                                <c:SwitchButton Style="{StaticResource ChipStyle}" Content="GPU" IsOn="{Binding IsGpu}" Command="{Binding SelectMetricCommand}" CommandParameter="GPU"/>
                                <c:SwitchButton Style="{StaticResource ChipStyle}" Content="RAM" IsOn="{Binding IsRam}" Command="{Binding SelectMetricCommand}" CommandParameter="RAM"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0" Height="170">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="100%" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Top"/>
                                <TextBlock Grid.Row="1" Text="75%" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Top"/>
                                <TextBlock Grid.Row="2" Text="50%" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Top"/>
                                <TextBlock Grid.Row="3" Text="25%" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Top"/>
                                <TextBlock Grid.Row="4" Text="0" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Bottom"/>
                            </Grid>
                            <Grid Grid.Column="1">
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,1"/>
                                <Viewbox Stretch="Fill">
                                    <Canvas Width="600" Height="160">
                                        <Line X1="0" X2="600" Y1="40" Y2="40" Stroke="#1D2030" StrokeThickness="1"/>
                                        <Line X1="0" X2="600" Y1="80" Y2="80" Stroke="#1D2030" StrokeThickness="1"/>
                                        <Line X1="0" X2="600" Y1="120" Y2="120" Stroke="#1D2030" StrokeThickness="1"/>
                                        <Polygon Points="{Binding ChartArea}" Fill="#337865FF"/>
                                        <Polyline Points="{Binding ChartLine}" Stroke="#7865FF" StrokeThickness="2.5" StrokeLineJoin="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{Binding ChartNote}" Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360"
                                           Visibility="{Binding HasChartNote, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Grid>
                        <TextBlock Text="Last 60 seconds · updates once per second only while this page is open" Style="{StaticResource Muted}" FontSize="11" Margin="40,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Game Mode panel -->
                <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Game Mode" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border HorizontalAlignment="Right" CornerRadius="6" Padding="10,3" Background="#1B1D2B" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                <TextBlock Text="{Binding GameModeBadge}" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardBorder}" Background="#0F1119" Margin="0,14,0,0" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Detected Game" Style="{StaticResource Muted}" FontSize="12"/>
                                <TextBlock Text="{Binding DetectedGame}" FontWeight="SemiBold" FontSize="15" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding DetectedGameSub}" Style="{StaticResource Muted}" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Background="#0F1119" Margin="0,10,0,0" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Current Preset" Style="{StaticResource Muted}" FontSize="12"/>
                                <TextBlock Text="{Binding PresetName}" FontWeight="SemiBold" FontSize="15" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <UniformGrid Columns="2" Margin="0,16,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="{Binding GameModeButton}" Command="{Binding ToggleGameModeCommand}" Margin="0,0,5,0"/>
                            <Button Style="{StaticResource GhostButton}" Content="Open" Command="{Binding OpenGameModeCommand}" Margin="5,0,0,0"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Your PC -->
            <TextBlock Text="Your PC" Style="{StaticResource SectionTitle}" Margin="0,26,0,12"/>
            <TextBlock Text="Run a scan to read your real hardware. Until then nothing is shown." Style="{StaticResource Muted}" Margin="0,-6,0,10" FontSize="12.5"
                       Visibility="{Binding NoSpecs, Converter={StaticResource BoolToVis}}"/>
            <ItemsControl ItemsSource="{Binding Specs}" Focusable="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Width="268" MinHeight="92" Margin="0,0,12,12" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="20" Foreground="{StaticResource VioletBrush}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" FontSize="12"/>
                                    <TextBlock Text="{Binding Value}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,2,0,4" ToolTip="{Binding Value}" MaxHeight="64"/>
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Recommendations / analysis panel -->
            <Grid Margin="0,18,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding RecommendationsHeader}" Style="{StaticResource SectionTitle}"/>
                <Border Grid.Column="1" CornerRadius="6" Padding="10,4" Background="#1B1D2B" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AiStatus}" FontSize="11.5" Style="{StaticResource Muted}" ToolTip="Recommendations are produced by built-in local rules. No data leaves this PC."/>
                </Border>
            </Grid>
            <TextBlock Text="{Binding RecommendationsEmpty}" Style="{StaticResource Muted}" FontSize="13"
                       Visibility="{Binding NoRecommendations, Converter={StaticResource BoolToVis}}"/>
            <ItemsControl ItemsSource="{Binding Recommendations}" Focusable="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Width="400" Margin="0,0,14,14" Padding="16,14">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding GroupLabel}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MagentaBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ConfidenceText}" Style="{StaticResource Muted}" FontSize="11"/>
                                </Grid>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Problem}" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12.5"/>
                                <TextBlock Text="{Binding Reason}" Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12.5"/>
                                <TextBlock Text="{Binding Evidence}" Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11.5" Opacity="0.8"/>
                                <Button Style="{StaticResource GhostButton}" Content="{Binding ActionText}" Command="{Binding ActionCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="16,6"
                                        Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
