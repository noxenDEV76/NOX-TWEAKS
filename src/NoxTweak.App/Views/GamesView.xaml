<UserControl x:Class="NoxTweak.App.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NoxTweak.App.Controls"
             Style="{StaticResource PageStyle}">
    <Grid Margin="32,40,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,10,0,0">
                <Border Style="{StaticResource CardBorder}" Padding="12,6" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource Muted}" FontSize="12.5"/>
                </Border>
                <Button Style="{StaticResource GhostButton}" Content="Rescan" Command="{Binding RescanCommand}" Margin="0,0,10,0" AutomationProperties.Name="Rescan games"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Add Game" Command="{Binding AddGameCommand}" AutomationProperties.Name="Add game"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left column -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,18,24">
                    <TextBlock Text="Global Optimization Presets" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                    <Border Style="{StaticResource CardBorder}" Padding="6">
                        <ItemsControl ItemsSource="{Binding Presets}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <c:SwitchButton Style="{StaticResource RadioRowStyle}" IsOn="{Binding IsOn}" Command="{Binding SelectCommand}" AutomationProperties.Name="{Binding Name}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5"/>
                                            <TextBlock Text="{Binding CountText}" Style="{StaticResource Muted}" FontSize="12"/>
                                        </StackPanel>
                                    </c:SwitchButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Game Mode" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock Text="{Binding GameModeStatus}" Foreground="{StaticResource SuccessBrush}" FontSize="12.5" Margin="0,2,0,0"/>
                                </StackPanel>
                                <c:SwitchButton Grid.Column="1" Style="{StaticResource SwitchStyle}" IsOn="{Binding GameModeActive, Mode=OneWay}"
                                                Command="{Binding ToggleModeCommand}" AutomationProperties.Name="Game Mode"/>
                            </Grid>
                            <TextBlock Text="{Binding GameModeText}" Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding SelectedPresetName, StringFormat=Selected preset: {0}}" FontSize="12.5" Margin="0,8,0,0"/>
                            <Button Style="{StaticResource GhostButton}" Content="Edit Mode" Command="{Binding EditModeCommand}" Margin="0,12,0,0" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- My Games -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-12,0">
                <StackPanel Margin="0,0,12,24">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="My Games" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding GameCountText}" Style="{StaticResource Muted}" Margin="10,3,0,0"/>
                    </StackPanel>

                    <TextBlock Text="Scanning your launchers…" Style="{StaticResource Muted}" Margin="0,8,0,0"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" Margin="0,8,0,0"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>

                    <ItemsControl ItemsSource="{Binding Games}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Card" Style="{StaticResource CardBorder}" Width="200" Height="300" Margin="0,0,14,14" ClipToBounds="True" Padding="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Original generated cover (no third-party artwork) -->
                                        <Border Grid.Row="0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="{Binding ArtStart}" Offset="0"/>
                                                    <GradientStop Color="{Binding ArtEnd}" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Grid>
                                                <TextBlock Text="{Binding Initials}" FontSize="48" FontWeight="Bold" Foreground="#40FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="8,3" CornerRadius="10" Background="#99000000">
                                                    <TextBlock Text="{Binding Launcher}" FontSize="11"/>
                                                </Border>
                                                <c:SwitchButton Style="{StaticResource StarStyle}" IsOn="{Binding IsFavorite, Mode=OneWay}" Command="{Binding FavoriteCommand}"
                                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" AutomationProperties.Name="Favorite"/>

                                                <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10" Padding="8,3" CornerRadius="10" Background="{StaticResource VioletBrush}"
                                                        Visibility="{Binding IsLastPlayed, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="Last Played" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>

                                                <Button x:Name="LaunchBtn" Style="{StaticResource PrimaryButton}" Content="{Binding LaunchText}" Command="{Binding LaunchCommand}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" AutomationProperties.Name="Launch game"/>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Row="1" Margin="12,10,12,12">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding Location}"/>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding GameModeText}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
                                                <c:SwitchButton Grid.Column="1" Style="{StaticResource SwitchStyle}" IsOn="{Binding GameModeOn, Mode=OneWay}"
                                                                Command="{Binding GameModeCommand}" AutomationProperties.Name="Game Mode for this game"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions><Condition Property="IsMouseOver" SourceName="Card" Value="True"/></MultiTrigger.Conditions>
                                        <Setter TargetName="LaunchBtn" Property="Opacity" Value="1"/>
                                    </MultiTrigger>
                                    <Trigger Property="IsKeyboardFocusWithin" SourceName="Card" Value="True">
                                        <Setter TargetName="LaunchBtn" Property="Opacity" Value="1"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
