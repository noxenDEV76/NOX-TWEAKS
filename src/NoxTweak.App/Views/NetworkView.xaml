<UserControl x:Class="NoxTweak.App.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource PageStyle}">
    <Grid Margin="32,40,32,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0">
            <StackPanel Margin="0,0,12,24">
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,20"/>

                <TextBlock Text="Ping test" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                <Border Style="{StaticResource CardBorder}" Padding="18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Style="{StaticResource SearchBox}" Width="320" Padding="10,8" Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Host or IP address"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="Ping" Command="{Binding PingCommand}" Margin="10,0,0,0"/>
                            <Button Style="{StaticResource GhostButton}" Content="Ping my router" Command="{Binding PingRouterCommand}" Margin="10,0,0,0"/>
                            <Button Style="{StaticResource GhostButton}" Content="Ping public test" Command="{Binding PingPublicCommand}" Margin="10,0,0,0"/>
                            <Button Style="{StaticResource GhostButton}" Content="Cancel" Command="{Binding CancelCommand}" Margin="10,0,0,0"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Progress}" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding KindText}" Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding ResultText}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding Honesty}" Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Adapters" Style="{StaticResource SectionTitle}" Margin="0,22,0,10"/>
                <ItemsControl ItemsSource="{Binding Adapters}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Padding="16,12" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold"><Run Text="{Binding Kind, Mode=OneWay}"/> · <Run Text="{Binding Name, Mode=OneWay}"/></TextBlock>
                                    <TextBlock Style="{StaticResource Muted}" FontSize="12.5" Margin="0,4,0,0">
                                        <Run Text="{Binding State, Mode=OneWay}"/> · <Run Text="{Binding Speed, Mode=OneWay}"/> · Gateway: <Run Text="{Binding Gateway, Mode=OneWay}"/> · DNS: <Run Text="{Binding Dns, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
