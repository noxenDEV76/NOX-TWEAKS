<UserControl x:Class="NoxTweak.App.Views.OptimizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NoxTweak.App.Controls"
             Style="{StaticResource PageStyle}">
    <Grid Margin="32,40,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Optimize my PC" VerticalAlignment="Top" Margin="0,10,0,0"
                    Command="{Binding DataContext.OptimizeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    ToolTip="Applies only low-risk, reversible recommendations after showing you the list."/>
        </Grid>

        <!-- Tabs -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Tabs}" Margin="0,18,0,0" Focusable="False"
                      Visibility="{Binding HasTabs, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <c:SwitchButton Style="{StaticResource TabStyle}" Content="{Binding Name}" Glyph="{Binding Glyph}"
                                    IsOn="{Binding IsOn}" Command="{Binding Command}" AutomationProperties.Name="{Binding Name}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Search / Filter / Sort -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
            <Grid Width="280">
                <TextBox Style="{StaticResource SearchBox}" Padding="34,8,8,8" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Search optimizations"/>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Margin="12,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
            </Grid>

            <Grid Margin="10,0,0,0">
                <Button x:Name="FilterButton" Style="{StaticResource GhostButton}" Command="{Binding ToggleFilterCommand}" AutomationProperties.Name="Filter">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE71C;" FontSize="13" Margin="0,0,8,0" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="{Binding FilterLabel}"/>
                    </StackPanel>
                </Button>
                <Popup IsOpen="{Binding IsFilterOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=FilterButton}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="6">
                    <Border Style="{StaticResource CardBorder}" Padding="6" Background="#171A28">
                        <ItemsControl ItemsSource="{Binding FilterOptions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <c:SwitchButton Style="{StaticResource OptionStyle}" Content="{Binding Label}" IsOn="{Binding IsOn}" Command="{Binding Command}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Popup>
            </Grid>

            <Grid Margin="10,0,0,0">
                <Button x:Name="SortButton" Style="{StaticResource GhostButton}" Command="{Binding ToggleSortCommand}" AutomationProperties.Name="Sort">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8CB;" FontSize="13" Margin="0,0,8,0" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Sort"/>
                    </StackPanel>
                </Button>
                <Popup IsOpen="{Binding IsSortOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=SortButton}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="6">
                    <Border Style="{StaticResource CardBorder}" Padding="6" Background="#171A28">
                        <ItemsControl ItemsSource="{Binding SortOptions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <c:SwitchButton Style="{StaticResource OptionStyle}" Content="{Binding Label}" IsOn="{Binding IsOn}" Command="{Binding Command}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Popup>
            </Grid>
        </StackPanel>

        <!-- Cards -->
        <ScrollViewer Grid.Row="3" Margin="0,18,-12,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,12,24">
                <TextBlock Text="{Binding SectionTitle}" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                <TextBlock Text="{Binding AppsNote}" Style="{StaticResource Muted}" Margin="0,-6,0,12" FontSize="12.5"
                           Visibility="{Binding IsAppsTab, Converter={StaticResource BoolToVis}}"/>

                <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Muted}" Margin="0,24,0,0"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>

                <ItemsControl ItemsSource="{Binding Cards}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Width="300" Height="158" Margin="0,0,14,14" Padding="14,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{StaticResource VioletBrush}" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Title}"/>
                                        <Grid Grid.Column="2">
                                            <Button x:Name="InfoBtn" Style="{StaticResource IconButton}" Content="&#xE946;" Width="24" Height="24"
                                                    Command="{Binding InfoCommand}" ToolTip="Technical details" AutomationProperties.Name="Technical details"/>
                                            <Popup IsOpen="{Binding IsInfoOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=InfoBtn}" Placement="Bottom"
                                                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-300">
                                                <Border Style="{StaticResource CardBorder}" Background="#171A28" Width="360" Padding="16">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                        <TextBlock Text="{Binding InfoText}" TextWrapping="Wrap" Style="{StaticResource Muted}" FontSize="12.5" LineHeight="18"/>
                                                    </StackPanel>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                    </Grid>

                                    <TextBlock Grid.Row="1" Text="{Binding Description}" Style="{StaticResource Muted}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               FontSize="12.5" Margin="0,8,0,0" ToolTip="{Binding Description}"/>

                                    <TextBlock Grid.Row="2" Text="{Binding Status}" FontSize="12" Margin="0,0,0,6" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"
                                               Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Grid Grid.Row="3" Height="28">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                    Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}" ToolTip="{Binding WarningText}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="13" Foreground="{StaticResource DangerBrush}" Margin="0,0,6,0"/>
                                            <TextBlock Text="Warning" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                    Visibility="{Binding NoWarning, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="12" Margin="0,0,6,0"/>
                                            <TextBlock Text="No Warnings" FontSize="12.5" Style="{StaticResource Muted}"/>
                                        </StackPanel>
                                        <c:SwitchButton Grid.Column="1" Style="{StaticResource SwitchStyle}" IsOn="{Binding IsOn}" Command="{Binding ToggleCommand}"
                                                        AutomationProperties.Name="{Binding Title}"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
