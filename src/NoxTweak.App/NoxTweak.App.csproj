<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>NoxTweak</AssemblyName>
    <RootNamespace>NoxTweak.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\nox.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>NOX TWEAK</Product>
    <Company>NOX TWEAK</Company>
    <Description>Safe, reversible PC optimization for gaming</Description>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NoxTweak.Core\NoxTweak.Core.csproj" />
    <ProjectReference Include="..\NoxTweak.UI\NoxTweak.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\nox.ico" />
  </ItemGroup>

</Project>
