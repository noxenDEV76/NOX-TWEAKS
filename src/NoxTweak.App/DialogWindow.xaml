<Window x:Class="NoxTweak.App.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="Height"
        Width="520" MaxHeight="640" Background="Transparent" AllowsTransparency="True"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True">
    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.6" Color="Black"/>
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" LineHeight="21"/>
            <ScrollViewer x:Name="DetailsScroll" Grid.Row="2" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="260">
                <ItemsControl x:Name="DetailsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#0F1119" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" FontSize="12.5"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="SecondaryButton" Style="{StaticResource GhostButton}" Margin="0,0,10,0" Click="OnSecondary" IsCancel="True"/>
                <Button x:Name="PrimaryButtonControl" Style="{StaticResource PrimaryButton}" Click="OnPrimary" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
